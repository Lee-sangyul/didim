# 실행 환경
APP_ENV=development

# 데이터베이스
DATABASE_URL=sqlite:///./data/didim.db

# AI
DEMO_MODE=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 프런트엔드 접속 허용 주소
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 파일
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# 로그인 기능에서 사용할 예정
SESSION_SECRET=
COOKIE_SECURE=false